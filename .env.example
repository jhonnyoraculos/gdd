# Runtime URL. Prefer the pooled Neon URL (hostname containing -pooler).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Optional direct URL for Alembic migrations. Falls back to DATABASE_URL when omitted.
DATABASE_DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

DATABASE_SSLMODE=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_CONNECT_TIMEOUT=5
GDD_OWNER_NAME=Criador
GDD_OWNER_EMAIL=creator@gdd.local
APP_ENV=development
LOG_LEVEL=INFO
